# Zx Lens environment variables (copy to backend/.env for local development)

# App Configuration
APP_ENV=development
LOG_LEVEL=INFO

# Storage Paths (relative to FULL_PROJECT root)
CHROMA_PERSIST_DIR=backend/data/indices/chroma
BM25_PERSIST_DIR=backend/data/indices/bm25

# Retrieval hyperparameters
RRF_K=60
TOP_K_DENSE=25
TOP_K_SPARSE=25
TOP_N_RERANK=15
TOP_K_FINAL=5

# ==============================================================
# LLM Providers (any one is sufficient; Inception is tried first)
# ==============================================================
LLM_PROVIDER=inception
INCEPTION_API_KEY=
INCEPTION_BASE_URL=https://api.inceptionlabs.ai/v1
INCEPTION_MODEL=mercury-3

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

OPENAI_API_KEY=
